PUBLIC_DOMAIN=health.example.com
POSTGRES_DB=realfood
POSTGRES_USER=realfood
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_SIGNING_SECRET=replace-with-at-least-24-random-characters
MINIO_BUCKET=realfood-private-assets
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-a-long-minio-secret
# 可选：官方镜像源不可达时，通过部署环境覆盖；应用配置文件无需改动。
# NODE_IMAGE=docker.m.daocloud.io/node:24-alpine
# POSTGRES_IMAGE=docker.m.daocloud.io/postgres:16-alpine
# MINIO_IMAGE=docker.m.daocloud.io/minio/minio:RELEASE.2025-07-23T15-54-02Z
# MINIO_MC_IMAGE=docker.m.daocloud.io/minio/mc:RELEASE.2025-07-21T05-28-08Z
# CADDY_IMAGE=docker.m.daocloud.io/caddy:2.10-alpine
# ECS 外对象存储中的 Restic 仓库：
RESTIC_REPOSITORY=s3:https://offsite-object-storage.example.com/realfood-backups
RESTIC_PASSWORD=replace-with-a-long-backup-encryption-password
BACKUP_ACCESS_KEY=replace-with-offsite-access-key
BACKUP_SECRET_KEY=replace-with-offsite-secret-key
# 仅在首次配置或主动改密时临时使用，不要长期保存在 .env：
# SEED_ACCOUNTS_JSON=[{"username":"admin","displayName":"管理员","password":"999999"}]
